    try:
        # Simulate a design process
        if magnet_type == "quadrupole":
            num_turns = random.randint(50, 200)
            current = round(random.uniform(100, 500), 2)
            yoke_radius = round(aperture_size * random.uniform(1.5, 2.5), 2)
            achieved_b3 = round(random.uniform(0.1, 1.5), 2) # Simulate some multipole error
            achieved_b5 = round(random.uniform(0.05, 0.8), 2)
            design_status = "success"
        elif magnet_type == "dipole":
            num_turns = random.randint(100, 300)
            current = round(random.uniform(200, 800), 2)
            yoke_width = round(aperture_size * random.uniform(2, 4), 2)
            achieved_b2 = round(random.uniform(0.01, 0.1), 2)
            design_status = "success"
        else:
            raise ValueError("Unsupported magnet type for simulation")

        # Simulate a failure condition for some inputs
        if field_strength > 50 and magnet_type == "quadrupole":
            design_status = "failure: too high field"
            num_turns, current, yoke_radius, achieved_b3, achieved_b5 = [np.nan]*5 # Indicate failure

        return {
            "num_turns": num_turns,
            "current_A": current,
            "yoke_radius_mm": yoke_radius if magnet_type == "quadrupole" else np.nan,
            "yoke_width_mm": yoke_width if magnet_type == "dipole" else np.nan,
            "achieved_b3_10-4": achieved_b3 if magnet_type == "quadrupole" else np.nan,
