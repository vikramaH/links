.mw-notification-area { position: absolute; }

.mw-notification-area-floating { position: fixed; }

.mw-notification-area-overlay { position: absolute; top: 0px; right: 0px; height: 100%; width: 100%; overflow: hidden; pointer-events: none; }

.mw-notification-area { top: 0px; right: 0px; padding: 1em; width: 20em; line-height: 1.35; z-index: 10000; }

.mw-notification { padding: 0.75em 1.5em; margin-bottom: 0.5em; border: 1px solid rgb(221, 221, 221); background-color: rgb(255, 255, 255); color: rgb(0, 0, 0); cursor: pointer; opacity: 0; transform: translateX(35px); transition: opacity 0.35s ease-in-out, transform 0.35s ease-in-out; pointer-events: auto; }

.mw-notification-visible { opacity: 1; transform: translateX(0px); }

.mw-notification-replaced { opacity: 0; transform: translateY(-35px); pointer-events: none; }

.mw-notification-title { font-weight: bold; }

.mw-notification.mw-notification-type-warn { background-color: rgb(254, 246, 231); border-color: rgb(255, 204, 51); }

.mw-notification.mw-notification-type-error { background-color: rgb(254, 231, 230); border-color: rgb(221, 51, 51); }

.mw-notification.mw-notification-type-success { background-color: rgb(213, 253, 244); border-color: rgb(20, 134, 109); }

.mw-notification-area { font-size: 0.8em; }

.mw-notification-area-layout { top: 7em; }

.mw-notification { border: 1px solid rgb(162, 169, 177); border-radius: 2px; box-shadow: rgba(0, 0, 0, 0.25) 0px 2px 2px 0px; }

@media print {
  .mw-notification-area { display: none; }
}

@media screen {
  .toctoggle { user-select: none; font-size: 94%; }
}

#postedit-modqueued a { font-weight: bold; }

#pending-review { display: inline-block; padding: 5px; margin: 10px 10px 10px 0px; font-weight: bold; font-size: 120%; text-transform: uppercase; }
